#!/usr/bin/python3 -I
# SPDX-License-Identifier: MIT
"""mutis-admin: operator commands (spec §15.7). `mutis-admin --help` lists them."""
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from mutis import admin  # noqa: E402

if __name__ == "__main__":
    os.umask(0o007)           # files we create (the database, its -wal and -shm) stay within group mutis
    admin.main()
