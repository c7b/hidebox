#!/usr/bin/python3 -I
# SPDX-License-Identifier: MIT
"""mutis-cleanup: one cleanup pass (spec §8.2); a systemd timer runs it every 60 s as `mutis`."""
import argparse
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from mutis import cleanup, codec, config, db, logsafe  # noqa: E402
from mutis.storage import Blobs  # noqa: E402


def main() -> None:
    p = argparse.ArgumentParser(prog="mutis-cleanup")
    p.add_argument("--config")
    args = p.parse_args()
    logsafe.setup()
    cfg = config.load(args.config)
    conn = db.connect(cfg.db_path)
    try:
        counts = cleanup.run(conn, cfg, Blobs(cfg.blob_dir), os.statvfs, codec.now())
        logsafe.event("cleanup.run", count=sum(counts.values()))
    except Exception:
        logsafe.event("cleanup.error", "error")
        raise SystemExit(1)
    finally:
        conn.close()


if __name__ == "__main__":
    main()
