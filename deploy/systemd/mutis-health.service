# SPDX-License-Identifier: MIT
# The healthcheck (spec §15.6): data/health.json in full, status/status.json as the public subset.
[Unit]
Description=mutis healthcheck
RequiresMountsFor=/srv/mutis/data

[Service]
Type=oneshot
User=mutis
Group=mutis
Environment=MUTIS_CONFIG=/etc/mutis/mutis.toml
ExecStart=/usr/bin/python3 -I /srv/mutis/app/current/deploy/scripts/healthcheck.py
SyslogIdentifier=mutis-health
TimeoutStartSec=120

NoNewPrivileges=yes
ProtectSystem=strict
# health.json is written beside the database (data/), status.json for the site.
ReadWritePaths=/srv/mutis/data /srv/mutis/status
# Programs run only from /usr: the data directories, /tmp and every other writable place are noexec
# in this unit's view (docs/review/upload-safety-1.md).
NoExecPaths=/
ExecPaths=/usr
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
RemoveIPC=yes
UMask=0007
MemoryMax=256M
