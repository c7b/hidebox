# SPDX-License-Identifier: MIT
# The healthcheck (spec §15.6): data/health.json in full, status/status.json as the public subset.
[Unit]
Description=mutis healthcheck
RequiresMountsFor=/srv/mutis/data

[Service]
Type=oneshot
User=mutis
Group=mutis
Environment=MUTIS_CONFIG=/etc/mutis/mutis.toml
ExecStart=/usr/bin/python3 -I /srv/mutis/app/current/deploy/scripts/healthcheck.py
SyslogIdentifier=mutis-health
TimeoutStartSec=120

NoNewPrivileges=yes
ProtectSystem=strict
# health.json is written beside the database (data/), status.json for the site.
ReadWritePaths=/srv/mutis/data /srv/mutis/status
# Nothing this unit can write is executable in its view: its private /tmp, /var/tmp and /dev/shm and every
# path it may write are noexec (NoExecPaths=/ would not reach the private mounts, and ExecPaths= would
# lift ProtectSystem's read-only flag from the paths it names; docs/review/upload-safety-1.md).
NoExecPaths=/tmp /var/tmp /dev/shm /srv/mutis/data /srv/mutis/status
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
RemoveIPC=yes
UMask=0007
MemoryMax=256M
