# SPDX-License-Identifier: MIT
# One cleanup pass (spec §8.2): expired links, doomed blobs, abandoned uploads, tombstones.
[Unit]
Description=mutis cleanup pass

[Service]
Type=oneshot
User=mutis
Group=mutis
Environment=MUTIS_CONFIG=/etc/mutis/mutis.toml
ExecStart=/usr/bin/python3 -I /srv/mutis/app/current/server/bin/mutis-cleanup
SyslogIdentifier=mutis-cleanup
TimeoutStartSec=300

NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/srv/mutis/data
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
UMask=0007
MemoryMax=512M
