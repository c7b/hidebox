# SPDX-License-Identifier: MIT
# One cleanup pass (spec §8.2): expired links, doomed blobs, abandoned uploads, tombstones.
[Unit]
Description=mutis cleanup pass
RequiresMountsFor=/srv/mutis/data

[Service]
Type=oneshot
User=mutis
Group=mutis
Environment=MUTIS_CONFIG=/etc/mutis/mutis.toml
ExecStart=/usr/bin/python3 -I /srv/mutis/app/current/server/bin/mutis-cleanup
SyslogIdentifier=mutis-cleanup
TimeoutStartSec=300

NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/srv/mutis/data/db /srv/mutis/data/blobs
# Programs run only from /usr: the data directories, /tmp and every other writable place are noexec
# in this unit's view (docs/review/upload-safety-1.md).
NoExecPaths=/
ExecPaths=/usr
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
RemoveIPC=yes
UMask=0007
MemoryMax=512M
