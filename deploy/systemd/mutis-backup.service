# SPDX-License-Identifier: MIT
# Daily database backup as `mutis` (spec §8.3): data/backup/mutis-YYYYMMDD.sqlite3, each copy (and
# each pre-migrate copy) deleted after 7 days. The one step with full privileges ("+") first deletes
# the database copies the operator playbooks leave under /var/backups/mutis (root, 0700) at the same
# age; nothing else there is touched.
# Blobs are never backed up: a file that made its exit must not live on in our backups.
[Unit]
Description=mutis database backup
RequiresMountsFor=/srv/mutis/data

[Service]
Type=oneshot
User=mutis
Group=mutis
Environment=MUTIS_CONFIG=/etc/mutis/mutis.toml
ExecStartPre=+/usr/bin/python3 -I /usr/local/lib/mutis/backup.py prune-root
ExecStart=/usr/bin/python3 -I /usr/local/lib/mutis/backup.py db
SyslogIdentifier=mutis-backup
TimeoutStartSec=600

NoNewPrivileges=yes
ProtectSystem=strict
# Reading a WAL database needs write access to its -shm index, hence db/ as well as backup/.
ReadWritePaths=/srv/mutis/data/db /srv/mutis/data/backup
# Nothing this unit can write is executable in its view: its private /tmp, /var/tmp and /dev/shm and every
# path it may write are noexec (NoExecPaths=/ would not reach the private mounts, and ExecPaths= would
# lift ProtectSystem's read-only flag from the paths it names; docs/review/upload-safety-1.md).
NoExecPaths=/tmp /var/tmp /dev/shm /srv/mutis/data/db /srv/mutis/data/backup
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
RemoveIPC=yes
UMask=0007
MemoryMax=512M
