# SPDX-License-Identifier: MIT
# The official Ootle wallet daemon (Esmeralda testnet), as `drive`, on 127.0.0.1:5100 only.
# The chain worker sends through it; it never decides a credit (spec §2.3). Replaces the tmux session.
[Unit]
Description=Ootle wallet daemon for mutis (Esmeralda testnet)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=drive
Group=drive
ExecStart=/usr/local/lib/mutis/run-walletd.sh
LoadCredential=keyring-pass:/etc/mutis/credentials/walletd-keyring-pass
RuntimeDirectory=walletd
RuntimeDirectoryMode=0700
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
KillSignal=SIGINT
StandardOutput=journal
StandardError=journal
SyslogIdentifier=walletd

# Hardening. walletd runs WebAssembly templates (JIT), so no MemoryDenyWriteExecute.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=tmpfs
BindPaths=/home/drive/wallet /home/drive/.local/share/tari
# walletd has no business with the visitors' data or mutis's own secrets (drive is in group mutis).
InaccessiblePaths=/srv/mutis -/etc/mutis/secret.key -/etc/mutis/mutis.toml -/etc/mutis/caddy.env
# Nothing this unit can write is executable in its view: its private /tmp, /var/tmp and /dev/shm and every
# path it may write are noexec (NoExecPaths=/ would not reach the private mounts, and ExecPaths= would
# lift ProtectSystem's read-only flag from the paths it names; docs/review/upload-safety-1.md).
NoExecPaths=/tmp /var/tmp /dev/shm /home/drive/wallet /home/drive/.local/share/tari
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
RemoveIPC=yes
UMask=0077
MemoryMax=2G
TasksMax=256

[Install]
WantedBy=multi-user.target
