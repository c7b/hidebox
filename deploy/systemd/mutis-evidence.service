# SPDX-License-Identifier: MIT
# Public testnet evidence (spec §15.6): status/evidence.json from evidence jobs only (the canary
# delivery and the daily evidence payment). Never user ids, invoices or addresses.
[Unit]
Description=mutis evidence collector
RequiresMountsFor=/srv/mutis/data

[Service]
Type=oneshot
User=drive
Group=drive
SupplementaryGroups=mutis
Environment=MUTIS_CONFIG=/etc/mutis/mutis.toml
ExecStart=/usr/bin/python3 -I /srv/mutis/app/current/deploy/scripts/collect-evidence.py
SyslogIdentifier=mutis-evidence
TimeoutStartSec=120

NoNewPrivileges=yes
ProtectSystem=strict
# Reading a WAL database needs write access to its -shm index.
ReadWritePaths=/srv/mutis/status /srv/mutis/data/db
ReadOnlyPaths=/home/drive/mutis
# Nothing this unit can write is executable in its view: its private /tmp, /var/tmp and /dev/shm and every
# path it may write are noexec (NoExecPaths=/ would not reach the private mounts, and ExecPaths= would
# lift ProtectSystem's read-only flag from the paths it names; docs/review/upload-safety-1.md).
NoExecPaths=/tmp /var/tmp /dev/shm /srv/mutis/status /srv/mutis/data/db
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
RemoveIPC=yes
UMask=0007
MemoryMax=256M
