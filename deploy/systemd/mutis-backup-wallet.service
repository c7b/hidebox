# SPDX-License-Identifier: MIT
# Daily copy of walletd's database and the receiver and robot keys as `drive` (spec §8.3), into
# /home/drive/wallet/backup/ (0600; each copy deleted after 7 days). Never moves or edits the wallet itself.
[Unit]
Description=mutis wallet and key backup

[Service]
Type=oneshot
User=drive
Group=drive
ExecStart=/usr/bin/python3 -I /usr/local/lib/mutis/backup.py wallet
SyslogIdentifier=mutis-backup-wallet
TimeoutStartSec=600

NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/home/drive/wallet/backup
# Programs run only from /usr: the data directories, /tmp and every other writable place are noexec
# in this unit's view (docs/review/upload-safety-1.md).
NoExecPaths=/
ExecPaths=/usr
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
RemoveIPC=yes
UMask=0077
MemoryMax=512M
