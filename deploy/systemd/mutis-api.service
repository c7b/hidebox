# SPDX-License-Identifier: MIT
# The internet-facing API on 127.0.0.1:8787 behind Caddy (spec §2.2, §15.4). Runs as `mutis`, which
# owns the blobs and the database and cannot reach walletd (ufw uid guard on port 5100).
[Unit]
Description=mutis API
After=network.target
RequiresMountsFor=/srv/mutis/data
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=mutis
Group=mutis
Environment=MUTIS_CONFIG=/etc/mutis/mutis.toml
ExecStart=/usr/bin/python3 -I /srv/mutis/app/current/server/bin/mutis-api
Restart=on-failure
RestartSec=2
TimeoutStopSec=25
SyslogIdentifier=mutis-api

NoNewPrivileges=yes
ProtectSystem=strict
# The database and the blobs; the backups and health.json beside them stay read-only to the API.
ReadWritePaths=/srv/mutis/data/db /srv/mutis/data/blobs
# Nothing this unit can write is executable in its view: its private /tmp, /var/tmp and /dev/shm and every
# path it may write are noexec (NoExecPaths=/ would not reach the private mounts, and ExecPaths= would
# lift ProtectSystem's read-only flag from the paths it names; docs/review/upload-safety-1.md).
NoExecPaths=/tmp /var/tmp /dev/shm /srv/mutis/data/db /srv/mutis/data/blobs
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
RemoveIPC=yes
UMask=0007
MemoryMax=1G
# One thread per request; idle threads cost little memory, and Caddy buffers request bodies, so
# slow clients don't hold them. A low cap would turn a burst of slow downloads into 502s for all.
TasksMax=2048

[Install]
WantedBy=multi-user.target
