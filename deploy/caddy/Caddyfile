# SPDX-License-Identifier: MIT
# mutis on Caddy 2.6 (spec §15.2). Installed as /etc/caddy/Caddyfile by deploy/scripts/provision.sh.
# MUTIS_HOST comes from /etc/mutis/caddy.env, which provision.sh writes from public_origin in
# /etc/mutis/mutis.toml. Headers and CSPs are spec §14.2, checked by tests/e2e/test_headers.py.
{
	# The admin API listens on a socket only root and caddy can reach, so no local user can
	# reconfigure the web server (the default is an unauthenticated TCP port).
	admin unix//run/caddy/admin.sock
	servers {
		protocols h1 h2
		timeouts {
			read_header 10s
			read_body 120s
			write 600s
			idle 120s
		}
	}
	# No access log anywhere. Errors only, with every request field that could identify a visitor
	# or a link removed (spec §14.3). tests/e2e/test_logs.py checks the journal from outside.
	log default {
		output stderr
		format filter {
			wrap console
			fields {
				request>remote_ip delete
				request>client_ip delete
				request>remote_port delete
				request>host delete
				request>uri delete
				request>headers delete
				request>tls delete
			}
		}
		level ERROR
	}
}

# A move to a new domain adds its redirect blocks here (deploy/README.md, "Moving to a domain").
import /etc/caddy/mutis.d/*.caddy

# Plain HTTP only redirects (Let's Encrypt's HTTP challenge is answered before this block). Written
# out instead of Caddy's automatic redirect so that it, too, sends no Server header.
http://{$MUTIS_HOST} {
	header -Server
	redir https://{host}{uri} 308
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
	}
	# A deletion is applied when the response is written; kept apart so the headers above are set
	# at once and survive error responses too.
	header -Server
}

# Pages and their scripts revalidate on every visit (ETags keep that cheap). A page cached by
# heuristics could otherwise outlive a deploy and carry an SRI hash its new script no longer has.
(revalidate) {
	header Cache-Control "no-cache"
}

(site_csp) {
	header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests"
}

(app_csp) {
	header Content-Security-Policy "default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; style-src 'self'; img-src 'self' blob: data:; media-src 'self' blob:; font-src 'self'; connect-src 'self' https://ootle-indexer-a.tari.com https://ootle-indexer-b.tari.com; manifest-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; require-trusted-types-for 'script'; trusted-types mutis-url; upgrade-insecure-requests"
}

{$MUTIS_HOST} {
	# No `log` directive: no access log.
	root * /srv/mutis/app/current/dist
	import security_headers
	encode {
		zstd
		gzip
		match {
			header Content-Type text/*
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type application/wasm
			header Content-Type application/manifest+json*
			header Content-Type image/svg+xml*
		}
	}

	# The pages the ghost folded together (14-ghost-design §4.1): every old address keeps working, with
	# or without a trailing slash. tests/e2e/headers_spec.py REDIRECTS says the same (test_config.py
	# compares them; test_headers.py asks the live site).
	@old_security path /security /security/
	redir @old_security "/made#locks" 301
	@old_privacy path /privacy /privacy/
	redir @old_privacy "/fine-print#privacy" 301
	@old_terms path /terms /terms/
	redir @old_terms "/fine-print#terms" 301
	@old_abuse path /abuse /abuse/
	redir @old_abuse "/fine-print#report" 301
	@old_pricing path /pricing /pricing/
	redir @old_pricing "/made#limits" 301
	@old_faq path /faq /faq/
	redir @old_faq "/made" 301
	@old_status path /status /status/
	redir @old_status "/made#check" 301
	# The drive replaced the locker (16-drive-design §12): its three pages answer 301 to their place in it.
	@old_locker path /locker /locker/
	redir @old_locker "/drive" 301
	@old_inbox path /inbox /inbox/
	redir @old_inbox "/drive/received" 301
	@old_upgrade path /upgrade /upgrade/
	redir @old_upgrade "/drive/storage#more" 301
	# /v3 became the home (docs/review/promote-v3.md): the preview's address answers 301 to /.
	@old_preview path /v3 /v3/
	redir @old_preview "/" 301

	# Types Go's MIME table lacks on Debian (it reads shared-mime-info, not /etc/mime.types).
	@webmanifest path *.webmanifest
	header @webmanifest Content-Type "application/manifest+json"
	@robotstxt path /robots.txt
	header @robotstxt Content-Type "text/plain; charset=utf-8"
	@sitemap path /sitemap.xml
	header @sitemap Content-Type "application/xml; charset=utf-8"
	@notice path */NOTICE
	header @notice Content-Type "text/plain; charset=utf-8"

	@api path /api/*
	# /p/*: the buyer page of a paid link
	@viewer path /s/* /t /p/*
	@approute path /d/* /send /send/* /watch /watch/* /verify /verify/*
	# The drive (16-drive-design §12) has its own page
	@drive path /drive /drive/*
	@appfiles path /app/* /vendor/*
	@status path /evidence.json /evidence-archive-*.json /status.json /releases.json
	@fonts path /shared/fonts/*
	# What other products show beside a link to us: the share cards (og:image) and the icons. Their names stay put
	# when their pictures change, so a day, not immutable.
	@cards path /og.png /og-s.png /favicon.ico /favicon.svg /favicon-32.png /apple-touch-icon.png /icon-192.png /icon-512.png
	@crawl path /robots.txt /sitemap.xml

	handle @api {
		import site_csp
		# No answer of the API belongs in a search index; /config and /stats stay fetchable for crawlers that render
		# the pages (robots.txt allows them).
		header X-Robots-Tag "noindex, nofollow"
		request_body {
			max_size 5MB
		}
		# A body declared longer than that limit is refused here, in the API's own error shape
		# (http_util.ApiError), before a byte of it is read: Caddy's limit would otherwise fail
		# mid-read inside the proxy and answer a bare 502.
		@too_large expression `{http.request.header.Content-Length} != "" && int({http.request.header.Content-Length}) > 5242880`
		handle @too_large {
			header Content-Type "application/json; charset=utf-8"
			header Cache-Control "no-store"
			respond `{"error":{"code":"too_large","message":"Request body too large.","details":{"max_bytes":5242880}}}` 413
		}
		# Caddy reads a whole request body (5 MB at most) before the API sees it, so a client that
		# uploads slowly holds a Caddy goroutine, never one of the API's threads.
		handle {
			reverse_proxy 127.0.0.1:8787 {
				buffer_requests
				max_buffer_size 6MB
				flush_interval -1
				header_up X-Real-IP {remote_host}
				header_up -X-Forwarded-For
				# The API sends nosniff itself (spec §6); Caddy already sets it on every response.
				header_down -X-Content-Type-Options
			}
		}
	}

	# Pages and files are read-only: a TRACE, PUT, POST or DELETE on them answers 405 (the API above
	# takes its own methods).
	@notread not method GET HEAD
	handle @notread {
		import site_csp
		header Allow "GET, HEAD"
		header Cache-Control "no-store"
		respond 405
	}

	handle @viewer {
		import app_csp
		import revalidate
		header X-Robots-Tag "noindex, nofollow"
		rewrite * /app/view.html
		file_server
	}

	handle @approute {
		import app_csp
		import revalidate
		header X-Robots-Tag "noindex, nofollow"
		rewrite * /app/app.html
		file_server
	}

	# The drive
	handle @drive {
		import app_csp
		import revalidate
		header X-Robots-Tag "noindex, nofollow"
		rewrite * /app/drive.html
		file_server
	}

	handle @appfiles {
		import app_csp
		import revalidate
		# /app/drive.html and its siblings are the drive's own pages under another address: never indexed.
		header X-Robots-Tag "noindex, nofollow"
		file_server
	}

	handle @status {
		import site_csp
		import revalidate
		root * /srv/mutis/status
		file_server
	}

	# A day, not immutable: the font file names carry no version (12-integration §2), and a font has
	# no SRI hash, so a stale one can only look old for a day, never break a page.
	handle @fonts {
		import site_csp
		header Cache-Control "public, max-age=86400"
		file_server
	}

	# The cards and icons are kept a day, and any site may show them: a chat or forum that draws a link's preview from
	# the page itself loads og:image from its own origin, which a same-origin resource policy would refuse. They are
	# public pictures with nothing to protect.
	handle @cards {
		import site_csp
		header Cache-Control "public, max-age=86400"
		header Cross-Origin-Resource-Policy "cross-origin"
		file_server
	}

	# robots.txt and the sitemap change only with a release: an hour is enough.
	handle @crawl {
		import site_csp
		header Cache-Control "public, max-age=3600"
		file_server
	}

	# The home page is the product (the drop widget), so it gets the app policy.
	@home path / /index.html
	handle @home {
		import app_csp
		import revalidate
		file_server
	}

	# /v2 (docs/review/home-v2.md): the home with the product loops, at an address no page links. It carries the
	# drop widget too, so it gets the app policy, whose media-src lets the loops play; noindex as its page says.
	@preview path /v2 /v2/ /v2/index.html
	handle @preview {
		import app_csp
		import revalidate
		header X-Robots-Tag "noindex"
		rewrite * /v2/index.html
		file_server
	}

	# /v2's loops and the home's stills (media/v3, docs/review/promote-v3.md): files whose names carry no version, kept a
	# day like the font (never immutable), so the closing reuses the hero's bytes. The file server answers byte ranges, as
	# video players ask.
	@media path /site/media/*
	handle @media {
		import site_csp
		header Cache-Control "public, max-age=86400"
		file_server
	}

	handle {
		import site_csp
		import revalidate
		try_files {path} {path}/index.html
		file_server
	}

	# Error pages always come from the release, whatever root the failed route had (/status.json,
	# for one, is looked up in /srv/mutis/status), and are never cached.
	handle_errors {
		root * /srv/mutis/app/current/dist
		import security_headers
		import site_csp
		header Cache-Control "no-store"
		@missing expression `{err.status_code} == 404`
		handle @missing {
			rewrite * /404.html
			file_server {
				status 404
			}
		}
		handle {
			respond "" {err.status_code}
		}
	}
}

# Any other Host name, on either port: no site here. The same headers, nothing reflected, no
# redirect to a name a client made up (421 Misdirected Request).
(misdirected) {
	import security_headers
	import site_csp
	header Cache-Control "no-store"
	respond 421
}

https:// {
	import misdirected
}

http:// {
	import misdirected
}
