// /etc/apt/apt.conf.d/52mutis-unattended-upgrades (provision.sh): unattended-upgrades also takes Debian's point-release
// updates (trixie-updates), not only the security archive. The list adds to the one in 50unattended-upgrades.
Unattended-Upgrade::Origins-Pattern {
        "origin=Debian,codename=${distro_codename}-updates,label=Debian";
};
