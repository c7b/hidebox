#!/usr/sbin/nft -f
# SPDX-License-Identifier: MIT
# /etc/mutis-connlimit.nft, loaded by mutis-connlimit.service (provision.sh). Its own table beside ufw (ufw keeps its
# iptables-nft tables): one source may hold at most 100 open TCP connections to 80/443 (an IPv6 source counts per
# /64). A browser needs a handful; this only stops one host from exhausting Caddy.
table inet mutis_guard
delete table inet mutis_guard
table inet mutis_guard {
	set conn4 {
		type ipv4_addr
		size 65535
		flags dynamic
	}
	set conn6 {
		type ipv6_addr
		size 65535
		flags dynamic
	}
	chain input {
		type filter hook input priority filter - 5; policy accept;
		tcp dport { 80, 443 } ct state new ip saddr != 127.0.0.0/8 add @conn4 { ip saddr ct count over 100 } counter reject with tcp reset
		tcp dport { 80, 443 } ct state new ip6 saddr != ::1 add @conn6 { ip6 saddr and ffff:ffff:ffff:ffff:: ct count over 100 } counter reject with tcp reset
	}
}
